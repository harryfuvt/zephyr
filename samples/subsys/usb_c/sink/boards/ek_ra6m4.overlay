/*
 * Copyright (c) 2024 Renesas Electronics Corporation
 * SPDX-License-Identifier: Apache-2.0
 *
 * Board overlay for EK-RA6M4 + RAA489400 TCPC (USB-C sink)
 *
 * Place this file at:
 *   samples/subsys/usb_c/sink/boards/ek_ra6m4.overlay
 *
 * ── VBUS measurement note ───────────────────────────────────────
 *  VBUS voltage is read over I2C from the RAA489400's own ADC
 *  (VBUS_VOLTAGE register 0x70) using the generic
 *  "zephyr,usb-c-vbus-tcpci" driver, declared as a child node of
 *  the TCPC. NO SoC ADC or resistor divider is used, so the adc0
 *  node and the P000/AN000 divider are gone.
 *
 *  IMPORTANT: the RAA489400 driver must clear POWER_CONTROL (0x1C)
 *  bit6 (VBUS_VOLTAGE Monitor) during init — it defaults to 1b
 *  (monitoring disabled), which makes VBUS_VOLTAGE read 0x0000.
 *  The updated raa489400.c does this in raa489400_init().
 *
 * ── Hardware connections on EK-RA6M4 ────────────────────────────
 *  RAA489400 pin     EK-RA6M4 pin   Notes
 *  ───────────────   ────────────   ────────────────────────────────
 *  SCL  (pin 28)     P512 (SCL1)    IIC1 SCL, open-drain + ext 4.7kΩ
 *  SDA  (pin 29)     P511 (SDA1)    IIC1 SDA, open-drain + ext 4.7kΩ
 *  ALERT# (pin 31)   P009 (IRQ13)   Active-low, ext 10kΩ to VDD33
 *                                   Arduino J23-3 (D2/INT0)
 *  VSYS33 (pin 12)   3.3V rail
 *  VCONN_POWER(30)   5V rail        Required for VCONN MUX
 *  VBUS  (pin 14)    USB-C VBUS     (sensed internally by the TCPC)
 *  VSNK_GATE (18)    N-FET gate     External sink path MOSFET
 *  VSNK_SRC  (19)    N-FET source   External sink path MOSFET
 *  PROG  (pin 10)    1.0 kΩ to GND  → I2C address 0x22 (Table 1, datasheet)
 *  GND   (pin 24)    GND
 *
 *  IIC1 (P511/P512) is exposed on the EK-RA6M4 Arduino I2C header
 *  (J24-9 SDA / J24-10 SCL), Grove 1 (J27), Qwiic (J30), and mikroBUS
 *  (J22) connectors, so it is directly accessible for wiring to the
 *  RAA489400. IIC0 (P400/P401) is committed to the on-board Ethernet
 *  PHY (MDC/MDIO) via default trace-cut jumpers E24/E25 and is not
 *  broken out for general use, which is why we move to IIC1.
 *
 * ── Key facts from ra6-cm33-common.dtsi ─────────────────────────
 *  iic0 @ 0x4009f000   compatible = "renesas,ra-iic"   (no fixed irqs)
 *  iic1 @ 0x4009f100   compatible = "renesas,ra-iic"
 *
 * ── IMPORTANT: IIC interrupt note ───────────────────────────────
 *  The RA6M4 uses a flexible interrupt matrix (ICU). IIC interrupts
 *  are NOT fixed — they are assigned at build time in the ek_ra6m4
 *  pinctrl/board DTS. Check your actual build/zephyr/zephyr.dts to
 *  confirm the interrupt numbers assigned to iic1 before programming.
 *  The values below (32–35) follow the ek_ra6m4 board DTS convention;
 *  adjust if your build assigns different IRQ numbers:
 *      grep -A6 "iic1" build/zephyr/zephyr.dts
 *
 * ── Build command ────────────────────────────────────────────────
 *  west build -p always -b ek_ra6m4 samples/subsys/usb_c/sink
 * ─────────────────────────────────────────────────────────────────
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/usb-c/pd.h>

/* ================================================================
 * 1. Pin control — IIC1 default state
 *    P512 (port 5, pin 12) = SCL    RA_PSEL_I2C function
 *    P511 (port 5, pin 11) = SDA    RA_PSEL_I2C function
 *    Both must be open-drain for I2C.
 * ================================================================ */
&pinctrl {
	iic1_default: iic1_default {
		group1 {
			psels = <RA_PSEL(RA_PSEL_I2C, 5, 12)>,  /* P512 = SCL1 */
				<RA_PSEL(RA_PSEL_I2C, 5, 11)>;   /* P511 = SDA1 */
			drive-open-drain;
		};
	};
};

/* ================================================================
 * 2. IIC1 — enable and attach RAA489400
 *
 *    From ra6-cm33-common.dtsi:
 *      iic1 @ 0x4009f100, compatible = "renesas,ra-iic", channel = <1>
 *      clocks = <&pclkb MSTPB 8>
 *
 *    Interrupt numbers are flexible on RA6M4 (ICU matrix).
 *    Verify the assignments in your build with:
 *      grep -A6 "iic1" build/zephyr/zephyr.dts
 * ================================================================ */
&iic1 {
	status = "okay";
	pinctrl-0 = <&iic1_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;   /* 400 kHz */
	#address-cells = <1>;
	#size-cells = <0>;
	interrupts = <32 1>, <33 1>, <34 1>, <35 1>;
	interrupt-names = "rxi", "txi", "tei", "eri";

	/* ── RAA489400 TCPC at I2C address 0x22 ─────────────────────
	 * PROG pin = 1.0 kΩ to GND → address 0x22 (Table 1, datasheet)
	 * ALERT# = P009 (ioport0, pin 9), active-low open-drain.
	 *   P009 is IRQ13-capable and exposed on the Arduino digital
	 *   header at J23-3 (D2/INT0). It carries no default on-board
	 *   function, so it is free for use as the TCPC ALERT# input.
	 * ─────────────────────────────────────────────────────────── */
	raa489400_tcpc0: raa489400@22 {
		compatible = "renesas,raa489400";
		reg = <0x22>;
		alert-gpios = <&ioport0 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

		/*
		 * VBUS overcurrent threshold = 3.6 A (reset value from
		 * RAA489400 VBUS_FAULT_CTRL register bits[1:0] = 01b).
		 */
		vbus-oc-threshold = <1>;

		status = "okay";

		/* ── VBUS voltage measurement over I2C ───────────────
		 * The generic TCPCI VBUS driver reads VBUS_VOLTAGE
		 * (0x70) from the parent TCPC. It takes the I2C address
		 * from this node's parent (raa489400@22). No SoC ADC.
		 *
		 * NOTE: raa489400_init() must clear POWER_CONTROL bit6
		 * (VBUS_VOLTAGE Monitor) or this register reads 0.
		 * ──────────────────────────────────────────────────── */
		vbus0: vbus {
			compatible = "zephyr,usb-c-vbus-tcpci";
			status = "okay";
		};
	};
};

/* ================================================================
 * 3. Enable GPIO ports
 * ================================================================ */
/* Port 5 — for IIC1 pins P511/P512 */
&ioport5 {
	status = "okay";
};

&port_irq13 {
	interrupts = <90 12>;
	status = "okay";
};

&ioport0 {
	status = "okay";
	/* no irqs property — routing is via pinctrl above */
};


/* ================================================================
 * 4. Root node — aliases and USB-C port
 * ================================================================ */
/ {
	aliases {
		usbc-port0 = &port0;
	};

	/* ── USB-C port (sink only) ──────────────────────────────────
	 * PDOs: 5V/3A, 9V/3A, 15V/3A, 20V/3A
	 * RAA489400 supports EPR up to 48V/240W — add EPR PDOs if needed.
	 *
	 * VBUS stays under 25.6V for all SPR PDOs, so the TCPC's
	 * VBUS_VOLTAGE scale factor is always 00b (raw × 25 mV). If you
	 * add EPR PDOs above 25.6V, verify the TCPCI VBUS driver reads
	 * the scale-factor field (bits 11:10 of reg 0x70).
	 * ─────────────────────────────────────────────────────────── */
	ports {
		#address-cells = <1>;
		#size-cells    = <0>;

		port0: usbc-port@0 {
			compatible = "usb-c-connector";
			reg        = <0>;
			tcpc       = <&raa489400_tcpc0>;
			vbus       = <&vbus0>;
			power-role = "sink";
			sink-pdos  = <PDO_FIXED(5000,  3000, 0)
				      PDO_FIXED(9000,  3000, 0)
				      PDO_FIXED(15000, 3000, 0)
				      PDO_FIXED(20000, 3000, 0)>;
		};
	};
};
